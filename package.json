{
  "name": "schemascope",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Static, cross-domain catalog of ontologies and schemas with automated FAIR and quality evaluation.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && PORT=3300 node scripts/serve.mjs",
    "serve": "PORT=3300 node scripts/serve.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:online": "node scripts/validate.mjs --online",
    "import": "node scripts/import-bioregistry.mjs",
    "quality": "node scripts/quality.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "rescore": "node scripts/rescore.mjs",
    "images": "docker build -q -t schemascope/oops docker/oops && docker build -q -t schemascope/robot docker/robot",
    "refresh": "scripts/refresh.sh",
    "harvest": "python3 scripts/harvest.py",
    "discover": "python3 scripts/discover.py",
    "quality:all": "scripts/quality-all.sh",
    "validate:rubric": "node scripts/validate-rubric.mjs"
  }
}
