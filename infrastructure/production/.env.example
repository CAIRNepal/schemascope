# Production settings (copy to .env, fill in, keep it out of git).
SITE_DOMAIN=schemascope.org
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=
# 64+ random characters: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# GitHub OAuth app, callback https://<SITE_DOMAIN>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Superadmins (GitHub primary, verified email), comma-separated: audit log and rate-limit settings
SUPERADMIN_EMAILS=
RATE_LIMIT_ANON=60
RATE_LIMIT_USER=1000
# Rate-limit counters are per worker process: keep 1 unless you lower the limits accordingly
API_WORKERS=1
# Where the repository's data/ folder is on this server (updated by git pull after each evaluation run)
# DATA_DIR=/srv/schemascope/data

# Recommendation chat. Start the model with `--profile llm`; leave it out to answer with ranked matches only.
LLM_MODEL=llama3.2:1b
# CPU threads for the model (0 = all); memory cap for the llm container
LLM_THREADS=0
LLM_MEMORY=2g
# Chat questions per minute: signed out (per IP) and signed in (per user)
CHAT_RATE_ANON=6
CHAT_RATE_USER=20
