# Global options: limits that make slow or oversized requests cheap to refuse (a first line against abuse; large
# distributed attacks must be stopped earlier, by the hosting provider's firewall or a CDN).
{
	servers {
		timeouts {
			read_header 10s
			read_body 15s
			write 3m
			idle 2m
		}
		max_header_size 32KB
	}
}

# Public entry point: HTTPS (automatic certificates) → site server, which serves pages and proxies /api/ and /mcp/.
{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Flush immediately so streamed responses (the recommendation chat) arrive as they are written.
	request_body {
		max_size 1MB
	}
	reverse_proxy web:3000 {
		flush_interval -1
	}
}

# Optional: redirect www to the apex domain.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
