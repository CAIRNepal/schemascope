# Sandbox settings (copy to .env). Defaults work as they are.
SITE_PORT=8380
API_PORT=8381
POSTGRES_PORT=5433
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
PUBLIC_SITE_URL=http://localhost:8380
# Sign in without a GitHub app: /api/auth/dev-login?login=<name>
DEV_LOGIN=1
# Optional: a GitHub OAuth app for real sign-in (callback http://localhost:8380/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Emails (GitHub primary, verified) of superadmins: audit log, rate-limit settings
SUPERADMIN_EMAILS=
RATE_LIMIT_ANON=60
RATE_LIMIT_USER=1000
